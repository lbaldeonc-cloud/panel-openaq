# ---- Para desarrollo local (npm run dev) ----
# La usa el proxy de Vite en el servidor; NO se expone al navegador.
OPENAQ_API_KEY=tu_api_key_aqui

# ---- Para el build de producción / GitHub Pages ----
# OJO: esta SÍ queda visible en el código del navegador porque GitHub Pages
# no tiene servidor propio que la oculte. Usa la misma key, no pasa nada
# grave con una key gratuita de solo lectura, pero ten en cuenta que
# cualquiera podría verla si inspecciona el código.
VITE_OPENAQ_API_KEY=tu_api_key_aqui
